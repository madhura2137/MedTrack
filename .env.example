# ------------ FLASK APPLICATION CONFIGURATION ------------
# Replace with a secure random secret key (e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-secure-random-secret-key
FLASK_APP=app.py
FLASK_DEBUG=0
PORT=5000

# ------------ AWS CONNECTION CONFIGURATION (OPTIONAL) ------------
AWS_REGION=us-east-1
SNS_REGION=us-east-1
DYNAMODB_USERS_TABLE=UsersTable
DYNAMODB_APPOINTMENTS_TABLE=AppointmentsTable
SNS_TOPIC_ARN=
USE_AWS=false
